{
  "name": "pcb-parasitic-qspice",
  "version": "0.1.0",
  "private": true,
  "description": "PCB Parasitic Engine for QSPICE — extract R/L/C from PCB layouts and inject them into QSPICE projects",
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:worker": "python3 -m uvicorn main:app --app-dir worker --host 0.0.0.0 --port 8000 --reload",
    "build": "npm --prefix apps/web run build",
    "test:worker": "python3 -m unittest discover -s worker/tests -v",
    "typecheck": "npm --prefix apps/web run typecheck"
  }
}
