{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "npm run build",
      "installCommand": "npm ci --no-audit --no-fund",
      "bindings": [
        {
          "type": "service",
          "service": "worker",
          "format": "url",
          "env": "WORKER_URL"
        }
      ]
    },
    "worker": {
      "root": "worker",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "worker"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "worker"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
